{
  "name": "neurodown",
  "version": "0.2.0",
  "private": true,
  "description": "NeuroDown bot, strategic graph and Minecraft test farm",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "npm run build && npm run test:daemon && npm run test:farm",
    "test:daemon": "cd daemon && node --enable-source-maps --test --test-timeout=120000 ../dist/daemon/test/*.test.js",
    "test:farm": "node --enable-source-maps --test --test-timeout=120000 dist/farm/*.test.js scripts/*.test.mjs",
    "start:daemon": "npm run build && npm --prefix daemon start",
    "start:mcp": "npm run build && npm --prefix mcp start",
    "campaign": "npm run build && node dist/daemon/campaign.js",
    "farm": "npm run build && node dist/farm/farm.js",
    "rpc": "npm run build && node dist/run/rpc.js"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/ws": "8.18.2",
    "@typescript/typescript6": "6.0.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
