{
  "name": "swarm-run-minecraft-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP bridge for the Swarm Run Minecraft bot daemon.",
  "type": "module",
  "main": "../dist/mcp/src/index.js",
  "scripts": {
    "build": "npm --prefix .. run build",
    "typecheck": "npm --prefix .. run typecheck",
    "prestart": "npm run build",
    "presmoke": "npm run build",
    "start": "node --enable-source-maps ../dist/mcp/src/index.js",
    "smoke": "node ../dist/mcp/smoke.js",
    "smoke:live": "node ../dist/mcp/smoke.js --live"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  }
}
