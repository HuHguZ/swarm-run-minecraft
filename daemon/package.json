{
  "name": "neurodown-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Long-running Minecraft body for NeuroDown. Holds the mineflayer connection and the autopilot; exposes intents over WebSocket.",
  "main": "src/index.js",
  "imports": {
    "#core/*": "./src/core/*.js",
    "#body/*": "./src/*.js",
    "#strategy/*": "./src/campaign/*.js",
    "#tactics/*": "./src/tactics/*.js"
  },
  "scripts": {
    "build": "npm --prefix .. run build",
    "typecheck": "npm --prefix .. run typecheck",
    "prestart": "npm run build",
    "start": "node --enable-source-maps src/index.js",
    "pretest": "npm run build",
    "test": "node --enable-source-maps --test test/*.test.js"
  },
  "dependencies": {
    "@nxg-org/mineflayer-pathfinder": "^0.0.26",
    "canvas": "^3.2.3",
    "minecraft-data": "^3.112.0",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "puppeteer": "^25.5.0",
    "vec3": "^0.1.10",
    "ws": "^8.18.3"
  }
}
