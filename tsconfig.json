{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "daemon/src/**/*.ts",
    "daemon/test/**/*.ts",
    "daemon/*.ts",
    "daemon/campaign/**/*.ts",
    "daemon/scenes/**/*.ts",
    "daemon/arena/**/*.ts",
    "daemon/castle/**/*.ts",
    "daemon/sim/**/*.ts",
    "daemon/tools/**/*.ts",
    "farm/*.ts",
    "farm/analysis/**/*.ts",
    "farm/scenes/**/*.ts",
    "farm/series/**/*.ts",
    "farm/swarm/**/*.ts",
    "farm/arena/**/*.ts",
    "farm/crystal/**/*.ts",
    "farm/dragon/**/*.ts",
    "farm/movement/**/*.ts",
    "farm/portal-scan/**/*.ts",
    "farm/route-scan/**/*.ts",
    "farm/stronghold_route/**/*.ts",
    "farm/stuck/**/*.ts",
    "mcp/**/*.ts",
    "run/*.ts"
  ],
  "exclude": ["**/node_modules", "dist", "dist-*", "farm/dragon/codex-*"]
}
